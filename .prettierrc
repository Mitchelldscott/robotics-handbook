{
  "printWidth": 80,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed", 
  "jsxSingleQuote": false, 
  "trailingComma": "es5", 
  "bracketSpacing": true,
  "arrowParens": "always", 
  "proseWrap": "always", 
  "htmlWhitespaceSensitivity": "css", 
  "endOfLine": "auto"
}
